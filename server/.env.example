# Supabase → Project Settings → API
SUPABASE_URL=https://你的專案.supabase.co

# ⚠️ service_role key，只能放在 Railway 後端，絕不可放進前端
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# 允許呼叫此 API 的前端網址（多個用逗號分隔）；留空 = 全部允許
ALLOWED_ORIGIN=https://你的網站.netlify.app

# Railway 會自動注入 PORT，本機開發才需要
PORT=8080
